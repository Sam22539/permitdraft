{
  "$version": "1.0.0",
  "color": {
    "navy": { "950": "#071326", "900": "#0B1B33", "800": "#13264A", "700": "#22385F", "600": "#3B5078" },
    "orange": { "100": "#FFEDD5", "300": "#FDBA74", "500": "#F97316", "600": "#EA580C", "700": "#C2410C", "800": "#9A3412" },
    "gray": { "50": "#F4F5F7", "100": "#EEF1F5", "200": "#DFE4EB", "300": "#C9D1DC", "500": "#8A93A3", "600": "#5A6779", "700": "#3E4A5C" },
    "ink": "#0B1B33",
    "marketing": { "warmWhite": "#FAF9F6", "warmBorder": "#E6E2D8", "black": "#05080F" },
    "onNavy": { "default": "#FFFFFF", "muted": "#C3CEDD", "faint": "#9FB0C8" },
    "status": {
      "success":   { "bg": "#DCFCE7", "fg": "#166534", "border": "#A7E3BC" },
      "conflict":  { "bg": "#FEF3C7", "fg": "#78350F", "border": "#D97706" },
      "missing":   { "bg": "#F4F5F7", "fg": "#374151", "border": "#8A93A3", "borderStyle": "dashed" },
      "info":      { "bg": "#E0E7FF", "fg": "#1E3A8A" },
      "submitted": { "bg": "#EDE9FE", "fg": "#5B21B6" },
      "ready":     { "bg": "#E0F2FE", "fg": "#075985" },
      "danger":    { "bg": "#FEE2E2", "fg": "#991B1B" }
    },
    "support": {
      "successIcon": "#15803D", "successDot": "#4ADE80", "successSoftBg": "#F0FDF4", "successSoftFg": "#14532D",
      "conflictSoftBg": "#FFFBEB", "conflictSoftBorder": "#F2C46B", "noticeBg": "#FFF7ED", "badgeRed": "#DC2626",
      "photoPlaceholder": "#3A4352", "cameraBg": "#05080F", "cameraControl": "#1A2233",
      "mapLand": "#E4EBE1", "mapGrid": "#D3DDD0", "rowDivider": "#EEF1F5"
    },
    "chart": ["#16A34A", "#7C3AED", "#2563EB", "#EA580C", "#94A3B8", "#7DD3FC"],
    "action": { "primary": "#C2410C", "primaryHover": "#9A3412", "primaryText": "#FFFFFF", "disabledBg": "#DEE2E8", "disabledText": "#4B5563" }
  },
  "font": {
    "display": "Space Grotesk",
    "ui": "Inter",
    "mono": "JetBrains Mono"
  },
  "type": {
    "home.hero":     { "font": "display", "size": 84, "weight": 700, "lineHeight": 0.95, "tracking": "-0.03em", "mobileSize": 48 },
    "home.h2":       { "font": "display", "size": 56, "weight": 700, "lineHeight": 1.0,  "tracking": "-0.03em", "mobileSize": 36 },
    "home.cta":      { "font": "display", "size": 72, "weight": 700, "lineHeight": 0.98, "tracking": "-0.03em", "mobileSize": 40 },
    "home.h3":       { "font": "display", "size": 36, "weight": 700, "lineHeight": 1.05 },
    "home.step":     { "font": "display", "size": 64, "weight": 700, "lineHeight": 1.0, "color": "orange.500" },
    "home.lead":     { "font": "ui", "size": 20, "weight": 400, "lineHeight": 1.55 },
    "home.body":     { "font": "ui", "size": 16, "weight": 400, "lineHeight": 1.6 },
    "eyebrow":       { "font": "mono", "size": 13, "weight": 500, "tracking": "0.14em", "case": "upper" },
    "office.h1":     { "font": "ui", "size": 26, "weight": 800 },
    "office.h2":     { "font": "ui", "size": 15, "weight": 700 },
    "office.kpi":    { "font": "ui", "size": 28, "weight": 800 },
    "office.body":   { "font": "ui", "size": 14, "weight": 400 },
    "office.table":  { "font": "ui", "size": 13, "weight": 400 },
    "office.label":  { "font": "ui", "size": 12, "weight": 700, "tracking": "0.05em", "case": "upper" },
    "app.title":     { "font": "display", "size": 28, "weight": 700, "tracking": "-0.02em" },
    "app.jobTitle":  { "font": "display", "size": 24, "weight": 700 },
    "app.cardTitle": { "font": "ui", "size": 17, "weight": 700 },
    "app.item":      { "font": "ui", "size": 15, "weight": 600 },
    "app.sub":       { "font": "ui", "size": 13, "weight": 400 },
    "app.button":    { "font": "ui", "size": 17, "weight": 700 },
    "app.section":   { "font": "ui", "size": 12, "weight": 700, "tracking": "0.06em", "case": "upper" }
