  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "14": 56, "18": 72, "28": 112 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 16, "2xl": 24, "pill": 999 },
  "layout": {
    "home.maxWidth": 1200, "home.gutter": 32, "home.sectionPadY": 112,
    "office.sidebar": 230, "office.topbar": 64, "office.pagePad": 20, "office.rightRail": 280,
    "app.frame": "390x844", "app.pagePad": 16, "app.cardGap": 10
  },
  "touch": { "min": 44, "field": 56, "cameraShutter": 84 }
}
